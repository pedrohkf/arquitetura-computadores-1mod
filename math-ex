\subsection*{Exercício 6 -- Soma de Frações}

\textbf{a) } $\frac{3}{9}+\frac{5}{9} = \frac{3+5}{9} = \frac{8}{9}$

\vspace{0.4cm}

\textbf{b) } $\frac{19}{35}+\frac{7}{35} = \frac{19+7}{35} = \frac{26}{35}$

\vspace{0.4cm}

\textbf{c) } $\frac{1}{2}+\frac{1}{3}$
\begin{align*}
    &MMC(2,3) = 6 \\
    &\frac{1}{2}+\frac{1}{3} = \frac{3}{6} + \frac{2}{6} = \frac{5}{6}
\end{align*}

\textbf{d) } $\frac{3}{4}+\frac{5}{6}$
\begin{align*}
    &4=2^2; \quad 6=2 \times 3 \implies MMC(4,6) = 12 \\
    &\frac{3}{4}+\frac{5}{6} = \frac{9}{12} + \frac{10}{12} = \frac{19}{12}
\end{align*}

\textbf{e) } $\frac{4}{3}+\frac{5}{7}$
\begin{align*}
    &MMC(3,7) = 21 \\
    &\frac{4}{3}+\frac{5}{7} = \frac{28}{21} + \frac{15}{21} = \frac{43}{21}
\end{align*}

\subsection*{Exercício 7 -- Subtração de Frações}

\textbf{a) } $\frac{7}{9}-\frac{2}{9} = \frac{7-2}{9} = \frac{5}{9}$

\vspace{0.3cm}

\textbf{b) } $\frac{9}{12}-\frac{4}{12} = \frac{9-4}{12} = \frac{5}{12}$

\vspace{0.3cm}

\textbf{c) } $\frac{3}{4}-\frac{1}{6}$
\begin{align*}
    &MMC(4,6) = 12 \\
    &\frac{9}{12} - \frac{2}{12} = \frac{7}{12}
\end{align*}

\textbf{d) } $\frac{5}{6}-\frac{1}{3}$
\begin{align*}
    &MMC(6,3) = 6 \\
    &\frac{5}{6} - \frac{2}{6} = \frac{3}{6} = \frac{1}{2}
\end{align*}

\textbf{e) } $\frac{8}{15}-\frac{2}{9}-\frac{1}{3}$
\begin{align*}
    &15=3 \times 5; \quad 9=3^2; \quad 3=3 \implies MMC=45 \\
    &\frac{24}{45} - \frac{10}{45} - \frac{15}{45} = \frac{24-10-15}{45} = -\frac{1}{45}
\end{align*}

\subsection*{Exercício 8 -- Multiplicação e Divisão de Frações}

\textbf{a) } $\frac{4}{5} \times \frac{2}{3} = \frac{4 \times 2}{5 \times 3} = \frac{8}{15}$

\vspace{0.3cm}

\textbf{b) } $\frac{7}{8} \times \frac{6}{7} \times \frac{3}{2} = \frac{\text{\sout{7}} \times 18}{16 \times \text{\sout{7}}} = \frac{18}{16} = \frac{9}{8} = 1\frac{1}{8}$

\vspace{0.3cm}

\textbf{c) } $\frac{9}{10} \times \frac{5}{12} = \frac{45}{120} = \frac{3}{8}$

\vspace{0.3cm}

\textbf{d) } $\frac{2}{3} \div \frac{4}{5} = \frac{2}{3} \times \frac{5}{4} = \frac{10}{12} = \frac{5}{6}$

\vspace{0.3cm}

\textbf{e) } $\frac{4}{9} \div \frac{2}{3} = \frac{4}{9} \times \frac{3}{2} = \frac{12}{18} = \frac{2}{3}$

\vspace{0.3cm}

\textbf{f) } $\frac{7}{8} \div \frac{14}{15} = \frac{7}{8} \times \frac{15}{14} = \frac{105}{112} = \frac{15}{16}$

\subsection*{Exercício 9 -- MDC e Simplificação}

\textbf{a) } $MDC(24,36) = 12 \implies \frac{24 \div 12}{36 \div 12} = \frac{2}{3}$

\textbf{b) } $MDC(48,60) = 12 \implies \frac{48 \div 12}{60 \div 12} = \frac{4}{5}$

\textbf{c) } $MDC(21,35,42) = 7$ (Divisor comum: $21=3\cdot7, 35=5\cdot7, 42=6\cdot7$)

\textbf{d) Definição:} O MDC é o maior divisor comum. Ele divide numerador e denominador simultaneamente para gerar a fração irredutível.

\subsection*{Exercício 10 -- Ordem das Operações}


\textbf{a) } $5 + 2 \times (8 - 3)^2$
\begin{align*}
    5 + 2 \times (5)^2 \rightarrow 5 + 2 \times 25 \rightarrow 5 + 50 = 55
\end{align*}

\textbf{b) } $\left(\frac{12}{2+1}\right)+4\times2$
\begin{align*}
    \left(\frac{12}{3}\right) + 8 \rightarrow 4 + 8 = 12
\end{align*}

\textbf{c) } $2^{3^2} = 2^9 = 512$

\vspace{0.3cm}

\textbf{d) } $3+6\times(5+4)\div3^2$
\begin{align*}
    3 + 6 \times 9 \div 9 \rightarrow 3 + 54 \div 9 \rightarrow 3 + 6 = 9
\end{align*}

\textbf{e) } $2\times(1+(4\times(2+1)+3))$
\begin{align*}
    2 \times (1 + (4 \times 3 + 3)) \rightarrow 2 \times (1 + (12 + 3)) \rightarrow 2 \times 16 = 32
\end{align*}

